// lit.dev Playground sandbox, deployed as a Cloudflare Worker with static
// assets. It must be on a different origin than the main site (wrangler.jsonc).
{
  "name": "lit-dev-playground",
  "compatibility_date": "2025-11-01",
  "assets": {
    // Generated by npm run build:cloudflare (playground-elements files plus a
    // _headers file).
    "directory": "./packages/lit-dev-server/cloudflare-playground-out",
    // Serve files exactly as named; playground-elements requests .html files.
    "html_handling": "none"
  }
}
