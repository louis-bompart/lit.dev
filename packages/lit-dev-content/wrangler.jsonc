// lit.dev main site, deployed as a Cloudflare Worker with static assets.
//
// Workers Builds settings: root directory packages/lit-dev-content, build
// command `npm run build:cloudflare`, default deploy commands, and these
// build variables:
//   LITDEV_MAIN_URL        Public URL of this Worker, e.g.
//                          https://lit-dev.<subdomain>.workers.dev
//   LITDEV_PLAYGROUND_URL  Public URL of the playground sandbox Worker
//                          (packages/lit-dev-playground), e.g.
//                          https://lit-dev-playground.<subdomain>.workers.dev/
{
  "name": "lit-dev",
  "compatibility_date": "2025-11-01",
  "assets": {
    // Generated by `npm run build:cloudflare`. Includes _redirects, _headers
    // and 404.html (see packages/lit-dev-server/cloudflare-prepare.mjs).
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
